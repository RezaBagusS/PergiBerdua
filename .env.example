# Copy to .env, then replace both secrets before running.
POSTGRES_PASSWORD=replace-with-a-random-database-password
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_SECRET=admin12345
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
PORT=3000
# Local emails are captured in Mailpit, not delivered to the internet.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PergiBerdua <hello@pergiberdua.local>
# APP_MODE=production requires HTTPS, secure cookies and SMTP credentials.
APP_MODE=development
