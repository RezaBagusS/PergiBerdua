# ===================================================
# STAGING ENVIRONMENT (Branch: stg / Vercel Deployment)
# ===================================================
# URL API staging backend (misal dideploy di VPS staging / Railway / Render)
# Next.js BFF proxy akan meneruskan request /api/* ke URL ini
API_INTERNAL_URL=https://api-staging.yourdomain.com

# Domain public staging di Vercel (harus sama persis dengan URL browser)
APP_ORIGIN=https://pergiberdua-stg.vercel.app

# Wajib true karena Vercel berjalan di HTTPS
COOKIE_SECURE=true
