# ===================================================
# STAGING ENVIRONMENT (Vercel Fullstack Deployment)
# ===================================================
# URL Database PostgreSQL Cloud (contoh: Neon.tech, Supabase, atau Railway)
DATABASE_URL=postgres://user:password@ep-staging.region.neon.tech/pergiberdua?sslmode=require

# Secret acak minimal 32 karakter untuk HMAC OTP dan hashing sesi
AUTH_SECRET=rahasia-minimal-32-karakter-acak-untuk-sesi-staging

# Domain publik di Vercel (harus sama persis dengan origin browser)
APP_ORIGIN=https://pergiberdua-stg.vercel.app

# Wajib true karena Vercel berjalan di HTTPS
COOKIE_SECURE=true

# Provider SMTP Staging (contoh: Resend / Mailtrap / SendGrid / Brevo)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_your_api_key_here
MAIL_FROM=PergiBerdua Staging <staging@domainanda.com>

# Mode aplikasi
APP_MODE=production
