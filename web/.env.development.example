# ===================================================
# LOCAL DEVELOPMENT ENVIRONMENT (Fullstack Next.js)
# ===================================================
# Koneksi database PostgreSQL lokal (port 5432 dari compose.dev.yaml)
DATABASE_URL=postgres://pergiberdua:password_dari_env_root@127.0.0.1:5432/pergiberdua

# Secret acak untuk HMAC OTP & Sesi (minimal 32 karakter)
AUTH_SECRET=rahasia-minimal-32-karakter-acak-untuk-sesi-lokal

# Origin browser di lokal
APP_ORIGIN=http://localhost:3000

# Cookie secure false untuk pengujian HTTP localhost
COOKIE_SECURE=false

# SMTP lokal (Mailpit port 1025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=PergiBerdua <hello@pergiberdua.local>

# Mode aplikasi
APP_MODE=development

# (Opsional) Jika tetap ingin memakai API terpisah (proxy mode):
# API_INTERNAL_URL=http://127.0.0.1:3001
