# URL upstream API internal untuk Next.js proxy
# Saat menjalankan: docker compose -f compose.yaml -f compose.dev.yaml up -d
API_INTERNAL_URL=http://127.0.0.1:3001

# Origin frontend di lokal
APP_ORIGIN=http://localhost:3000

# Cookie secure false untuk pengujian HTTP localhost
COOKIE_SECURE=false
